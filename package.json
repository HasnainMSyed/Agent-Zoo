{
  "name": "agent-zoo",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "A desktop app for Claude Code, Codex and Grok, with mascots",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --linux deb AppImage --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.12",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "homepage": "https://github.com/HasnainMSyed/Agent-Zoo",
  "author": {
    "name": "Hasnain Syed",
    "email": "HasnainMSyed@users.noreply.github.com"
  },
  "build": {
    "appId": "io.github.hasnainmsyed.agentzoo",
    "productName": "Prompt Habitat",
    "icon": "src/renderer/src/assets/prompt-habitat-logo.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "executableName": "agent-zoo",
      "synopsis": "A desktop app for Claude Code, Codex and Grok",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HasnainMSyed",
        "repo": "Agent-Zoo",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "PromptHabitat"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Prompt Habitat",
      "artifactName": "Prompt-Habitat-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "artifactName": "Prompt-Habitat-${version}-${arch}.${ext}"
    }
  },
  "desktopName": "agent-zoo.desktop"
}
